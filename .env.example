# URL de base de l'API REST (backend PostgreSQL). Par défaut : /api/v1 (même origine).
# En local, Vite redirige /api vers http://localhost:4000 (voir vite.config.ts).
# En production (Vercel), soit une URL absolue, soit une réécriture /api → backend.
VITE_API_URL=/api/v1
VITE_MOCK=false

# Optionnel : URL du canal temps réel. Par défaut : VITE_API_URL + /ws (ws:// ou wss://).
# VITE_WS_URL=wss://api.exemple.mg/api/v1/ws
